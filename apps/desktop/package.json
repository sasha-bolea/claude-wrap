{
  "name": "@claude-wrap/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "node-pty": "1.2.0-beta.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@claude-wrap/client": "*",
    "@claude-wrap/core": "*",
    "@claude-wrap/protocol": "*",
    "@claude-wrap/server": "*",
    "@claude-wrap/ui": "*",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  },
  "productName": "claude-wrap",
  "build": {
    "appId": "dev.claude-wrap",
    "npmRebuild": false,
    "productName": "claude-wrap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/node-pty/**"
    ]
  }
}
