# Environment of the AtHome server: copy to ~/.config/claude-wrap/env (chmod 600) and fill in.
# Not in the repository: the tailnet address and the login identify the owner's network.

# Folder sessions may run in (the only one the phone can browse).
CLAUDE_WRAP_ROOT=/srv/progetti
# Address the phone and the desktop use: the Tailscale Serve HTTPS address of this server.
CLAUDE_WRAP_PUBLIC_URL=https://HOST.TAILNET.ts.net:8443
# Owner's Tailscale login (as Serve sets it in Tailscale-User-Login); other tailnet users are refused.
CLAUDE_WRAP_TAILSCALE_LOGIN=
# Listen address (Tailscale Serve forwards :8443 here). Registered port: 3012.
CLAUDE_WRAP_PORT=3012
CLAUDE_WRAP_HOST=127.0.0.1
# State (devices, VAPID keys, tabs): default ~/.local/state/claude-wrap
#CLAUDE_WRAP_STATE_DIR=
# Shared browser (Chromium headless, DevTools on loopback only). Registered port: 3013.
# Off unless CLAUDE_WRAP_BROWSER=1; without a Chromium at CLAUDE_WRAP_CHROME it stays off.
#CLAUDE_WRAP_BROWSER=1
#CLAUDE_WRAP_BROWSER_PORT=3013
#CLAUDE_WRAP_CHROME=~/.cache/ms-playwright/chromium-1247/chrome-linux64/chrome
